# Runtime: protected host .env; owner credentials are used only for migrations.
DATABASE_URL=postgres://the_date_pot_runtime:REPLACE@postgres:5432/the_date_pot
APP_ORIGIN=https://thedatepot.co.uk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Authentication provider: clerk (default and rollback) or better-auth.
AUTH_PROVIDER=clerk
# Required only when AUTH_PROVIDER=better-auth. See deploy/README.md.
BETTER_AUTH_URL=https://thedatepot.co.uk
BETTER_AUTH_SECRET=
BREVO_API_KEY=
AUTH_EMAIL_FROM=
AUTH_EMAIL_DAILY_LIMIT=40
# Optional: empty keeps sign-up open; a comma list restricts accounts to it.
AUTH_ALLOWED_EMAILS=
# Optional: server-side geocoding for the map on coffee, restaurant and activity pages
GOOGLE_MAPS_API_KEY_GEOCODING=
# Immutable, provenance-verified release chosen by deploy-core.
DATE_POT_IMAGE=ghcr.io/kylescudder/the-date-pot@sha256:REPLACE
